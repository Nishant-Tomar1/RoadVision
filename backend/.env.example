# Path to the trained YOLO weights. Place best.pt inside backend/model/ or override here.
MODEL_PATH=model/best.pt

# Inference settings
CONF_THRESHOLD=0.3
IOU_THRESHOLD=0.5
TRACKER=bytetrack.yaml

# Upload limits (bytes). Default 100 MB.
MAX_UPLOAD_SIZE=104857600

# Comma-separated origins allowed by CORS. Use * for all.
CORS_ORIGINS=*
